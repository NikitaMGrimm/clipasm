clipasm 1

config {
    video {
        width = 320
        height = 180
        fps = 24
    }
    output = "generated/reusable-composition.mp4"
}

clip {
    image("assets/morning.png", 1s, contain)
    zoom_in
} as opening

clip {
    image("assets/meadow.png", 1s, contain)
    zoom_in(2%)
} as meadow

clip {
    image("assets/evening.png", 1s, contain)
} as closing

$opening
$meadow
flash_cut(200ms)
$closing
concat
